{
  "name": "campus-loop",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["web"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=campus-loop-web",
    "lint:web": "npm run lint --workspace=campus-loop-web",
