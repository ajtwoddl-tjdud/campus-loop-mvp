{
  "name": "campus-loop",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "npm run dev --workspace=campus-loop-web",
    "test": "npm run test:web && npm run test:worker",
    "test:web": "npm test --workspace=campus-loop-web",
    "test:worker": "vitest run --config worker/vitest.config.mts",
    "lint:web": "npm run lint --workspace=campus-loop-web",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "check:worker-types": "wrangler types --check",
    "build": "npm run build --workspace=campus-loop-web",
    "preview": "wrangler dev",
    "d1:migrate:local": "wrangler d1 migrations apply campus-loop --local",
    "d1:migrate:remote": "wrangler d1 migrations apply campus-loop --remote",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
